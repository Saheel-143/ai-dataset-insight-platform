# AI Dataset Insight Platform Configuration

# ========================================================
# ENVIRONMENT MODE SELECTION: "local" (Default) or "s3" / "dynamodb" / "cognito"
# ========================================================
STORAGE_MODE=local
DB_MODE=local
AUTH_MODE=local

# Security
JWT_SECRET=super-secret-dataset-insight-jwt-key-2026

# Backend Host & Port
HOST=127.0.0.1
PORT=8000

# Frontend API URL
VITE_API_URL=http://127.0.0.1:8000

# ========================================================
# AWS CLOUD CONFIGURATION 
# ========================================================
# AWS_REGION=us-east-1
# AWS_S3_BUCKET_NAME=ai-dataset-insight-data-bucket
# DYNAMODB_DATASETS_TABLE=ai-dataset-insight-datasets-dev
# DYNAMODB_CHATS_TABLE=ai-dataset-insight-chats-dev
# DYNAMODB_USERS_TABLE=ai-dataset-insight-users-dev
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

